# .clang-tidy generated: Google style checks
# This configuration enables Google checks and other useful groups,
# while disabling a few noisy or project-specific checks.
---
Checks: >
  -*,
  google-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  modernize-*,
  performance-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*
WarningsAsErrors: ""
HeaderFilterRegex: ".*"
FormatStyle: google
CheckOptions:
  - key: google-readability-braces-around-statements.ShortStatementLines
    value: 1
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key: modernize-use-nullptr.NullMacros
    value: "NULL"
  - key: google-build-using-namespace
    value: 0
  - key: google-runtime-int
    value: int
  - key: google-readability-namespace-comments.ShortNamespaceStartOnASingleLine
    value: 0
  - key: google-readability-braces-around-statements.ShortStatementLines
    value: 1
